{
  "name": "@open-dcp/utilities",
  "description": "Shared utilities for Open DCP ecosystem",
  "version": "1.1.2",
  "engines": {
    "node": ">=18.8.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./node/dependencyChangeSummary": {
      "import": "./dist/node/dependencyChangeSummary.js",
      "types": "./dist/node/dependencyChangeSummary.d.ts"
    },
    "./node/checkDependencyPolicy": {
      "import": "./dist/node/checkDependencyPolicy.js",
      "types": "./dist/node/checkDependencyPolicy.d.ts"
    },
    "./node/enforceInstallPolicy": {
      "import": "./dist/node/enforceInstallPolicy.js",
      "types": "./dist/node/enforceInstallPolicy.d.ts"
    },
    "./vite/MoveConfigPlugin": {
      "import": "./dist/vite/MoveConfigPlugin.js",
      "types": "./dist/vite/MoveConfigPlugin.d.ts"
    },
    "./vite/SingleSpaTestPlugin": {
      "import": "./dist/vite/SingleSpaTestPlugin.js",
      "types": "./dist/vite/SingleSpaTestPlugin.d.ts"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "npm run dev",
    "dev": "tsc --watch",
    "build": "tsc",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "ts-jest": "^29.4.4",
    "typescript": "^5.7.3",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Roche/dcp-pkg-fe-ts-utilities.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
